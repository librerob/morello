    "list.hoverBackground": "#F2E8ED",
    "list.highlightForeground": "#286E53",
    "quickInput.background": "#FFF9FB",
    "quickInput.foreground": "#32232B",
    "editorWidget.background": "#FFF9FB",
    "editorWidget.foreground": "#32232B",
    "editorWidget.border": "#D1BBC5",
    "editorSuggestWidget.background": "#FFF9FB",
    "editorSuggestWidget.foreground": "#32232B",
    "editorSuggestWidget.selectedBackground": "#F4DEEA",
    "editorSuggestWidget.highlightForeground": "#286E53",
    "editorHoverWidget.background": "#FFF9FB",
    "editorHoverWidget.foreground": "#32232B",
    "editorHoverWidget.border": "#D1BBC5",
    "notifications.background": "#FFF9FB",
    "notifications.foreground": "#32232B",
    "notificationCenterHeader.background": "#EFE4EA",
