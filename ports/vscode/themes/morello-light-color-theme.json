    "gitDecoration.ignoredResourceForeground": "#765A68",
    "editor.findMatchHighlightBackground": "#62632126",
    "terminal.ansiBlack": "#32232B",
    "terminal.ansiRed": "#BD0F55",
    "terminal.ansiGreen": "#4D683C",
    "terminal.ansiYellow": "#964E07",
    "terminal.ansiBlue": "#096983",
    "terminal.ansiMagenta": "#97417B",
    "terminal.ansiCyan": "#286E65",
    "terminal.ansiWhite": "#EFE4EA",
    "terminal.ansiBrightBlack": "#765A68",
    "terminal.ansiBrightRed": "#AB235C",
    "terminal.ansiBrightGreen": "#3E6737",
    "terminal.ansiBrightYellow": "#815E17",
    "terminal.ansiBrightBlue": "#3B5E8C",
    "terminal.ansiBrightMagenta": "#824175",
    "terminal.ansiBrightCyan": "#246968",
    "terminal.ansiBrightWhite": "#FFF9FB"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#765A68"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#783429"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#286E53"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#626321"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#97417B"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#096983"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#32232B"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#483D42"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#585054"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#783429"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#286E53"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#286E53",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#286E53"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#BD0F55"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#32232B",
    "parameter": "#32232B",
    "property": "#32232B",
    "function": "#286E53",
    "method": "#286E53",
    "class": "#096983",
    "interface": "#096983",
    "struct": "#096983",
    "enum": "#096983",
    "type": "#096983",
    "typeParameter": "#096983",
    "namespace": "#096983",
    "enumMember": "#97417B",
    "variable.readonly": "#97417B",
    "keyword": "#783429",
    "comment": "#765A68",
    "string": "#626321",
    "number": "#97417B",
    "operator": "#483D42"
  }
}
