    "tab.activeBorderTop": "#286E53",
    "tab.inactiveBackground": "#EFE4EA",
    "tab.inactiveForeground": "#66505D",
    "tab.border": "#EFE4EA",
    "sideBar.background": "#EFE4EA",
    "sideBar.foreground": "#32232B",
    "sideBar.border": "#D1BBC5",
    "sideBarTitle.foreground": "#66505D",
    "sideBarSectionHeader.background": "#EFE4EA",
    "activityBar.background": "#EFE4EA",
    "activityBar.foreground": "#286E53",
