    "panelTitle.activeForeground": "#32232B",
    "panelTitle.inactiveForeground": "#66505D",
    "input.background": "#FFF9FB",
    "input.foreground": "#32232B",
    "input.border": "#D1BBC5",
    "input.placeholderForeground": "#765A68",
    "inputOption.activeBorder": "#286E53",
    "dropdown.background": "#FFF9FB",
    "dropdown.foreground": "#32232B",
    "dropdown.border": "#D1BBC5",
    "button.background": "#286E53",
