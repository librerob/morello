    "tab.border": "#23171E",
    "sideBar.background": "#23171E",
    "sideBar.foreground": "#E8DDE2",
    "sideBar.border": "#725260",
    "sideBarTitle.foreground": "#C0ABB6",
    "sideBarSectionHeader.background": "#23171E",
    "activityBar.background": "#23171E",
