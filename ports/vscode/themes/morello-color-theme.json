    "terminal.ansiBrightCyan": "#B9E3D8",
    "terminal.ansiBrightWhite": "#F5EBEF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AA94A0"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ECA994"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#A8D8BF"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#D3D59A"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#D7ADC3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A5BECA"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E8DDE2"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#C0ADB7"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#B3ABB2"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ECA994"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A8D8BF"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A8D8BF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A8D8BF"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F481AD"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E8DDE2",
    "parameter": "#E8DDE2",
    "property": "#E8DDE2",
    "function": "#A8D8BF",
    "method": "#A8D8BF",
    "class": "#A5BECA",
    "interface": "#A5BECA",
    "struct": "#A5BECA",
    "enum": "#A5BECA",
    "type": "#A5BECA",
    "typeParameter": "#A5BECA",
    "namespace": "#A5BECA",
    "enumMember": "#D7ADC3",
    "variable.readonly": "#D7ADC3",
    "keyword": "#ECA994",
    "comment": "#AA94A0",
    "string": "#D3D59A",
    "number": "#D7ADC3",
    "operator": "#C0ADB7"
  }
}
