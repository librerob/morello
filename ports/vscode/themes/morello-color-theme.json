    "terminal.ansiRed": "#F481AD",
    "terminal.ansiGreen": "#A8C99D",
    "terminal.ansiYellow": "#E5BF88",
    "terminal.ansiBlue": "#A5BECA",
    "terminal.ansiMagenta": "#D7ADC3",
    "terminal.ansiCyan": "#9ACDC3",
    "terminal.ansiWhite": "#D9CBD2",
